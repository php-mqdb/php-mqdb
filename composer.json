{
  "name": "php-mqdb/php-mqdb",
  "description": "PHP Message Queue with database. Provide some interface, trait & client to manage message queue in php.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",

  "authors": [
    {
      "name": "Romain Cottard",
      "role": "Developer"
    }
  ],

  "autoload": {
    "psr-4": {
      "PhpMqdb\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpMqdb\\Tests\\": "./tests"
    }
  },

  "config": {
    "sort-packages": true
  },

  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ramsey/uuid": "^4.0"
  },

  "suggest": {
    "doctrine/dbal": "Allow connection with Doctrine/DBAL rather than PDO",
    "eureka/component-database": "Have PDO factory to handle reconnection when necessary"
  },

  "require-dev": {
    "ext-pcntl": "*",
    "doctrine/dbal": "^4.4.3",
    "eureka/component-database": "^3.4.0||^4.0.0",
    "friendsofphp/php-cs-fixer": "^3.95.1",
    "phpstan/phpstan": "^2.1.54",
    "phpstan/phpstan-phpunit": "^2.0.16",
    "phpstan/phpstan-deprecation-rules": "^2.0.4",
    "phpstan/phpstan-strict-rules": "^2.0.11",
    "phpunit/phpcov": "^10.0.1",
    "phpunit/phpunit": "^11.5.55",
    "symfony/cache": "^7.4.10",
    "shipmonk/composer-dependency-analyser": "^1.8.4"
  }

}
